---
import DependencyGraph from "~/components/DependencyGraph.tsx";
---

<section class="stage" id="stage-graph" aria-label="dependency graph">
  <header class="stage-tag">
    <span class="num">03</span>
    <span class="name">dependency_graph</span>
  </header>

  <p class="lede">
    Each file from the previous stage becomes a node. Edges are real relationships —
    what builds on what.
  </p>

  <DependencyGraph client:visible />

  <p class="footnote">
    <span class="check">✓</span>
    <span>graph constructed</span>
    <span class="sep" aria-hidden="true">·</span>
    <span class="muted">14 nodes · 22 edges</span>
  </p>
</section>

<style>
  .stage {
    position: relative;
    min-height: 100vh;
    padding: var(--space-3xl) var(--space-l);
    max-width: var(--content-max);
    margin: 0 auto;
    border-top: 1px dashed var(--border);
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .stage-tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
  }

  .stage-tag .num {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .stage-tag .name {
    color: var(--built);
  }

  .stage-tag .name::before {
    content: "// ";
    color: var(--border);
  }

  .lede {
    color: var(--muted);
    font-size: var(--step-0);
    max-width: 60ch;
  }

  .footnote {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    padding-top: var(--space-s);
  }

  .footnote .check {
    color: var(--built);
  }

  .footnote .sep {
    color: var(--border);
  }

  .footnote .muted {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .stage {
      padding: var(--space-2xl) var(--space-m);
    }
  }
</style>
