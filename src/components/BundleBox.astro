---
const layers = [
  { id: "top", label: "yaddy.entry", side: "right", note: "12.4 kB", accent: true },
  { id: "ds", label: "design-systems", side: "left", note: "47 kB" },
  { id: "dt", label: "devtools", side: "right", note: "39 kB" },
  { id: "ap", label: "applications", side: "left", note: "54 kB" },
  { id: "co", label: "brotli + gzip", side: "right", note: "−80%" },
];
---

<figure class="bundle" role="img" aria-label="The portfolio's bundle, visualised as a stack of chunks">
  <svg
    class="bundle-svg"
    viewBox="-110 0 720 420"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="top-fill" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="rgb(232 163 61 / 0.22)" />
        <stop offset="100%" stop-color="rgb(232 163 61 / 0.06)" />
      </linearGradient>
      <linearGradient id="top-side" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="rgb(232 163 61 / 0.18)" />
        <stop offset="100%" stop-color="rgb(232 163 61 / 0.04)" />
      </linearGradient>
      <linearGradient id="layer-fill" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#1a2426" />
        <stop offset="100%" stop-color="#131b1d" />
      </linearGradient>
      <filter id="top-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" result="b" />
        <feMerge>
          <feMergeNode in="b" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <g class="cube">
      <!-- TOP LAYER (elevated, amber) -->
      <g class="layer layer-top" filter="url(#top-glow)">
        <!-- top face (rhombus) -->
        <path
          d="M 260 70 L 380 110 L 260 150 L 140 110 Z"
          fill="url(#top-fill)"
          stroke="#e8a33d"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <!-- left side -->
        <path
          d="M 140 110 L 260 150 L 260 175 L 140 135 Z"
          fill="url(#top-side)"
          stroke="#e8a33d"
          stroke-width="1.25"
          stroke-linejoin="round"
        />
        <!-- right side -->
        <path
          d="M 380 110 L 260 150 L 260 175 L 380 135 Z"
          fill="rgb(232 163 61 / 0.10)"
          stroke="#e8a33d"
          stroke-width="1.25"
          stroke-linejoin="round"
        />
        <!-- center mark -->
        <text
          x="260"
          y="115"
          text-anchor="middle"
          fill="#e8a33d"
          font-family="ui-monospace, monospace"
          font-size="11"
          letter-spacing="0.1em"
        >y</text>
      </g>

      <!-- STACK LAYERS (4 below, descending) -->
      {Array.from({ length: 4 }).map((_, i) => {
        const yOffset = 195 + i * 28;
        return (
          <g class={`layer layer-stack layer-${i + 1}`}>
            <path
              d={`M 260 ${yOffset} L 370 ${yOffset + 35} L 260 ${yOffset + 70} L 150 ${yOffset + 35} Z`}
              fill="url(#layer-fill)"
              stroke="#1e2a2d"
              stroke-width="1.25"
              stroke-linejoin="round"
            />
            <path
              d={`M 150 ${yOffset + 35} L 260 ${yOffset + 70} L 260 ${yOffset + 78} L 150 ${yOffset + 43} Z`}
              fill="#0a0e0f"
              stroke="#1e2a2d"
              stroke-width="1"
              stroke-linejoin="round"
            />
            <path
              d={`M 370 ${yOffset + 35} L 260 ${yOffset + 70} L 260 ${yOffset + 78} L 370 ${yOffset + 43} Z`}
              fill="#080b0c"
              stroke="#1e2a2d"
              stroke-width="1"
              stroke-linejoin="round"
            />
          </g>
        );
      })}

      <!-- CONNECTOR LINES + LABEL PILLS -->
      {layers.map((l, i) => {
        const ys = [110, 230, 258, 286, 314];
        const y = ys[i];
        const isLeft = l.side === "left";
        const startX = isLeft ? 150 : 370;
        const endX = isLeft ? 70 : 450;
        const labelAnchorX = isLeft ? 60 : 460;
        return (
          <g class={`connector ${isLeft ? "conn-left" : "conn-right"} ${l.accent ? "conn-accent" : ""}`}>
            <line
              x1={startX}
              y1={y}
              x2={endX}
              y2={y}
              stroke={l.accent ? "#e8a33d" : "#2a3539"}
              stroke-width="1"
              stroke-dasharray="2 4"
            />
            <circle
              cx={startX}
              cy={y}
              r="2.5"
              fill={l.accent ? "#e8a33d" : "#4f8c7e"}
            />
            <text
              x={labelAnchorX}
              y={y - 4}
              text-anchor={isLeft ? "end" : "start"}
              fill={l.accent ? "#e8a33d" : "#e8e1cf"}
              font-family="ui-monospace, monospace"
              font-size="10.5"
            >{l.label}</text>
            <text
              x={labelAnchorX}
              y={y + 10}
              text-anchor={isLeft ? "end" : "start"}
              fill="#5c6669"
              font-family="ui-monospace, monospace"
              font-size="9.5"
            >{l.note}</text>
          </g>
        );
      })}
    </g>
  </svg>

  <figcaption class="bundle-caption">
    the artifact · 5 layers · 39 kB shipped
  </figcaption>
</figure>

<style>
  .bundle {
    margin: 0;
    display: grid;
    place-items: center;
    gap: var(--space-s);
    padding: var(--space-l) 0;
  }

  .bundle-svg {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
    overflow: visible;
  }

  .bundle-caption {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* Float the elevated top layer */
  .layer-top {
    transform-origin: 260px 110px;
    animation: float 5.4s var(--ease-in-out) infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* Stagger a subtle reveal */
  .layer {
    opacity: 0;
    animation: layer-in 700ms var(--ease-out) forwards;
  }

  .layer-top { animation-delay: 1800ms, 0s; }
  .layer-1 { animation-delay: 2000ms; }
  .layer-2 { animation-delay: 2150ms; }
  .layer-3 { animation-delay: 2300ms; }
  .layer-4 { animation-delay: 2450ms; }

  .connector {
    opacity: 0;
    animation: layer-in 600ms var(--ease-out) forwards;
  }

  .connector:nth-of-type(1) { animation-delay: 2700ms; }
  .connector:nth-of-type(2) { animation-delay: 2850ms; }
  .connector:nth-of-type(3) { animation-delay: 3000ms; }
  .connector:nth-of-type(4) { animation-delay: 3150ms; }
  .connector:nth-of-type(5) { animation-delay: 3300ms; }

  @keyframes layer-in {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .connector {
      opacity: 1;
      animation: none;
    }
    .layer-top {
      animation: none;
    }
  }

  /* Mobile: shrink labels, then hide entirely on phones */
  @media (max-width: 640px) {
    .bundle-svg {
      max-width: 480px;
    }

    .connector text {
      font-size: 9.5px;
    }
  }

  @media (max-width: 420px) {
    .connector {
      display: none;
    }

    .bundle-svg {
      max-width: 280px;
    }
  }
</style>
