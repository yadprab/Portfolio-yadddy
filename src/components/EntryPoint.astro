---
import BundleBox from "~/components/BundleBox.astro";
---

<section class="stage" id="stage-entry" aria-label="entry point">
  <div class="stage-tag">
    <span class="num">01</span>
    <span class="name">entry_point</span>
  </div>

  <div class="terminal" role="presentation">
    <div class="prompt-line">
      <span class="prompt">$</span>
      <span class="cmd">
        <span class="cmd-text">yaddy build --target=production</span>
        <span class="caret" aria-hidden="true"></span>
      </span>
    </div>

    <div class="output">
      <p class="line line-1">
        <span class="check">✓</span> reading entry point
      </p>
      <p class="line line-2">
        <span class="check">✓</span> initialising compiler
      </p>
    </div>
  </div>

  <BundleBox />

  <div class="hero">
    <h1 class="name-display">
      <span class="word word-1">Yathavan</span>
      <span class="word word-2">Gomathi</span>
    </h1>
    <p class="tagline">
      Frontend engineer building applications, design systems, and developer tools.
      The page you are scrolling is a build pipeline.
    </p>
  </div>

  <a class="scroll-hint" href="/build" data-play-build aria-label="run the build pipeline">
    <span class="hint-arrow" aria-hidden="true">▶</span>
    <span class="hint-label">play build</span>
    <span class="hint-meta">live terminal · /build</span>
  </a>
</section>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>("[data-play-build]");
  if (trigger) {
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    trigger.addEventListener("click", (e) => {
      // Allow modifier-clicks (cmd, ctrl, middle-click) to open in a new tab
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      e.preventDefault();

      if (reduced) {
        window.location.href = "/build";
        return;
      }

      // Glitch transition · ~600ms total, navigate at ~350ms (mid-effect)
      document.documentElement.classList.add("page-glitching");
      trigger.classList.add("playing");

      window.setTimeout(() => {
        window.location.href = "/build";
      }, 360);
    });
  }
</script>

<style>
  .stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto auto auto auto;
    padding: var(--space-3xl) var(--space-l) var(--space-l);
    max-width: var(--content-max);
    margin: 0 auto;
    gap: var(--space-xl);
    align-content: space-between;
  }

  .stage-tag {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    opacity: 0;
    animation: fade-in 280ms var(--ease-out) 0ms forwards;
  }

  .stage-tag .num {
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .stage-tag .name {
    color: var(--built);
  }

  .stage-tag .name::before {
    content: "// ";
    color: var(--border);
  }

  .terminal {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    line-height: 1.8;
  }

  .prompt-line {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .cmd {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--text-strong);
  }

  .cmd-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: type 700ms steps(32, end) 200ms forwards;
  }

  .caret {
    display: inline-block;
    width: 0.6ch;
    height: 1.1em;
    margin-left: 2px;
    background: var(--accent);
    vertical-align: text-bottom;
    animation: blink 900ms steps(2, end) infinite;
  }

  .output {
    margin-top: var(--space-s);
    color: var(--muted);
  }

  .line {
    opacity: 0;
    transform: translateY(4px);
  }

  .line-1 {
    animation: line-in 280ms var(--ease-out) 950ms forwards;
  }

  .line-2 {
    animation: line-in 280ms var(--ease-out) 1100ms forwards;
  }

  .check {
    color: var(--built);
    margin-right: 0.4ch;
  }

  .hero {
    align-self: center;
    display: grid;
    gap: var(--space-l);
    max-width: 64ch;
  }

  .name-display {
    font-size: var(--step-6);
    line-height: 0.95;
    letter-spacing: -0.04em;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
  }

  .word {
    display: inline-block;
    opacity: 0;
    transform: translateY(24px);
  }

  .word-1 {
    animation: word-in 480ms var(--ease-out) 600ms forwards;
  }

  .word-2 {
    color: var(--accent);
    animation: word-in 480ms var(--ease-out) 780ms forwards;
  }

  .tagline {
    font-size: var(--step-1);
    color: var(--muted);
    line-height: 1.5;
    max-width: 48ch;
    opacity: 0;
    animation: fade-in 480ms var(--ease-out) 1300ms forwards;
  }

  .scroll-hint {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-xs) var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    opacity: 0;
    animation: fade-in 480ms var(--ease-out) 1700ms forwards;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .scroll-hint:hover,
  .scroll-hint:focus-visible {
    color: var(--text-strong);
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .scroll-hint.playing {
    border-color: var(--accent);
    color: var(--accent);
  }

  .scroll-hint.playing .hint-arrow {
    animation: none;
    transform: scale(1.05);
  }

  .scroll-hint.playing .hint-meta::before {
    content: "▮▮ ";
  }

  .scroll-hint.playing .hint-meta {
    color: var(--accent);
  }

  .hint-arrow {
    color: var(--accent);
    font-size: 0.8em;
    animation: pulse-arrow 1.8s var(--ease-in-out) infinite;
  }

  .hint-label {
    color: var(--text);
    white-space: nowrap;
  }

  .hint-meta {
    color: var(--muted);
    font-size: 0.85em;
    padding-left: var(--space-xs);
    border-left: 1px solid var(--border);
    white-space: nowrap;
  }

  @media (max-width: 540px) {
    .scroll-hint {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--space-2xs) var(--space-s);
      padding: var(--space-xs) var(--space-m);
    }

    .hint-meta {
      flex: 1 0 100%;
      padding-left: 1.6em;
      border-left: 0;
      white-space: normal;
    }
  }

  @keyframes pulse-arrow {
    0%, 100% { opacity: 1; transform: translateX(0); }
    50% { opacity: 0.5; transform: translateX(1px); }
  }

  @keyframes type {
    to { width: 100%; }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @keyframes line-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes word-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    to { opacity: 1; }
  }


  @media (max-width: 640px) {
    .stage {
      padding: var(--space-2xl) var(--space-m) var(--space-m);
      gap: var(--space-l);
    }
  }
</style>
